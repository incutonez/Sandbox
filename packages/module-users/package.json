{
  "name": "@incutonez/module-users",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "explode": "npm cache clean --force && npx rimraf package-lock.json **/node_modules --glob && npm i",
    "lint": "npx eslint --fix",
    "update:deps": "node ./updateDependencies.js",
    "update:versions": "node ./updateVersions.js"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@material-symbols/svg-400": "0.44.12",
    "@tanstack/vue-query": "5.102.2",
    "@tanstack/vue-table": "9.1.2",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-config": "5.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.5",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.9.0",
    "eslint-plugin-antfu": "3.2.3",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "lint-staged": "17.3.0",
    "semantic-release": "25.0.9",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-svg-loader": "5.1.1",
    "vue-tsc": "3.3.11"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,vue}": [
      "npx eslint --fix"
    ]
  }
}
